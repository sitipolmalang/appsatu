<Layouts.app flash={@flash}>
  <.header>
    Post {@post.id}
    <:subtitle>This is a post record from your database.</:subtitle>
    <:actions>
      <.button navigate={~p"/posts"}>
        <.icon name="hero-arrow-left" />
      </.button>
      <.button variant="primary" navigate={~p"/posts/#{@post}/edit?return_to=show"}>
        <.icon name="hero-pencil-square" /> Edit post
      </.button>
    </:actions>
  </.header>

  <.list>
    <:item title="Title">{@post.title}</:item>
    <:item title="Body">{@post.body}</:item>
    <:item title="Category">
      <%= if @post.category do %>
        {@post.category.name}
      <% else %>
        No category
      <% end %>      
    </:item>

    <:item title="Tags">
      <%= if @post.tags && length(@post.tags) > 0 do %>
        <%= Enum.map(@post.tags, & &1.name) |> Enum.join(", ") %>
      <% else %>
        No tags
      <% end %>
    </:item>

    <:item title="Published">{@post.published}</:item>
    <:item title="Images">
      <%= if @post.images && length(@post.images) > 0 do %>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          <div :for={image <- @post.images} class="space-y-1 rounded-xl border border-base-300 p-2">
            <img
              src={image.url}
              alt={image.filename}
              class="h-24 w-full rounded-md object-cover ring-1 ring-base-300"
            />
            <p class="text-xs font-medium uppercase tracking-wide text-base-content/60">{image.role}</p>
          </div>
        </div>
      <% else %>
        No images
      <% end %>
    </:item>
  </.list>
</Layouts.app>
